# Copy these values into your IDE or shell environment before starting the API.
# Spring Boot does not load .env files automatically.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=campus_market
DB_USERNAME=root
DB_PASSWORD=replace_with_your_local_mysql_password
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRATION=604800000
UPLOAD_PATH=./uploads/
SERVER_PORT=8080
